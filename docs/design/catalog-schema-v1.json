{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hyper Dot Editor CLI command catalog v1 (proposed, #66)",
  "description": "Proposed interface. A schema file does not make --commands-json or packaged catalogs implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cli_implementation",
    "cli_version",
    "entrypoint",
    "global_options",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cli_implementation": {
      "enum": [
        "rust",
        "python"
      ]
    },
    "cli_version": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "global_options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "description_ja"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "string",
            "integer",
            "color",
            "path",
            "choice",
            "boolean"
          ]
        },
        "description_ja": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "aliases",
        "kind",
        "min_values",
        "max_values",
        "required",
        "description_ja"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-[A-Za-z0-9]$"
          },
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "string",
            "integer",
            "color",
            "path",
            "choice",
            "boolean"
          ]
        },
        "min_values": {
          "type": "integer",
          "minimum": 0
        },
        "max_values": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description_ja": {
          "type": "string",
          "minLength": 1
        },
        "metavars": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "default": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "description_ja"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description_ja": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "usage",
        "summary",
        "summary_ja",
        "effect",
        "requires_project",
        "positionals",
        "options",
        "side_effects",
        "examples"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)*$"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "summary_ja": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "read",
            "create",
            "edit",
            "export",
            "interactive"
          ]
        },
        "requires_project": {
          "type": "boolean"
        },
        "positionals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "creates_project",
              "writes_project",
              "writes_output",
              "overwrites_existing",
              "discards_detail",
              "interactive_session"
            ]
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      }
    }
  }
}
